<!DOCTYPE suite SYSTEM
"https://testng.org/testng-1.0.dtd">

<suite name="CrossBrowserSuite"
parallel="tests"
       thread-count="2">

    <!-- Chrome Test -->

    <test name="ChromeTest">

        <parameter
                name="browser"
                value="chrome"/>

        <classes>

            <class
name="DP_Day_27.CrossBrowserTesting"/>

        </classes>

    </test>

    <!-- Edge Test -->

    <test name="EdgeTest">

        <parameter
                name="browser"
                value="edge"/>

        <classes>

            <class
name="DP_Day_27.CrossBrowserTesting"/>

        </classes>

    </test>

</suite>